// ZFC finite-fragment theorems — Metis island language is the source of truth.
island ZFC {
  theorem empty_in_singleton {
    let empty = ZFC::empty()
    let s0 = ZFC::finite_set(empty)
    ZFC::check(Member(empty, s0))
  }

  theorem pair_members {
    let a = ZFC::atom("a")
    let b = ZFC::atom("b")
    let p = ZFC::finite_set(a, b)
    ZFC::check(Member(a, p))
    ZFC::check(Member(b, p))
  }

  theorem pair_idempotent {
    let a = ZFC::atom("a")
    let s1 = ZFC::finite_set(a, a)
    let s2 = ZFC::finite_set(a)
    ZFC::check(Equal(s1, s2))
  }

  theorem empty_ne_singleton {
    let empty = ZFC::empty()
    let s0 = ZFC::finite_set(empty)
    ZFC::check(NotEqual(empty, s0))
  }

  theorem atom_not_in_empty {
    let a = ZFC::atom("a")
    let empty = ZFC::empty()
    ZFC::check(NotMember(a, empty))
  }
}
